{$CODEBRIDGE_DOMAIN} {
	encode zstd gzip

	# Never expose the administrative API through the public reverse proxy.
	@admin path /admin /admin/*
	respond @admin 404

	# Device agents use the same public TLS origin on port 443. Caddy
	# terminates TLS/HTTP2 and forwards gRPC to the Manager's internal
	# cleartext HTTP/2 listener.
	@grpc protocol grpc
	reverse_proxy @grpc h2c://manager:8081

	# MCP, OAuth metadata, plugin assets and health stay on the HTTP listener.
	reverse_proxy manager:8080

	header {
		-Server
		X-Content-Type-Options "nosniff"
		Referrer-Policy "no-referrer"
	}
}
