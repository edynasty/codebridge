FROM golang:1.25-alpine AS build
WORKDIR /src
COPY go.mod go.sum ./
RUN go mod download
COPY . .
RUN CGO_ENABLED=0 go build -trimpath -ldflags="-s -w" -o /out/codebridge-manager ./cmd/manager
RUN mkdir -p /out/data && chmod 700 /out/data

FROM gcr.io/distroless/static-debian12:nonroot
COPY --from=build /out/codebridge-manager /codebridge-manager
COPY --chown=65532:65532 --from=build /out/data /data
EXPOSE 8080
ENTRYPOINT ["/codebridge-manager"]
