# Manager
CODEBRIDGE_ADDR=:8080
CODEBRIDGE_STATE_FILE=./data/auth.json
CODEBRIDGE_ADMIN_TOKEN=change-me-admin-token
# Empty = JSONL audit events to stdout. Set a path to persist metadata-only audit logs.
CODEBRIDGE_AUDIT_LOG=./data/audit.jsonl

# Runtime limits
CODEBRIDGE_MAX_INFLIGHT_PER_DEVICE=8
CODEBRIDGE_MAX_MCP_INFLIGHT=16
CODEBRIDGE_MAX_MCP_REQUEST_BYTES=1048576
CODEBRIDGE_MAX_AGENT_CONNECTIONS=32

# OAuth 2.1 resource-server settings for ChatGPT/Codex linking.
# Leave all of these empty only for local/private development.
CODEBRIDGE_PUBLIC_URL=https://codebridge.example.com
CODEBRIDGE_OAUTH_ISSUER=https://auth.example.com
CODEBRIDGE_OAUTH_JWKS_URL=https://auth.example.com/.well-known/jwks.json
# Canonical protected-resource identifier. ChatGPT sends this as the OAuth
# resource parameter; the authorization server should issue it as aud.
CODEBRIDGE_OAUTH_RESOURCE=https://codebridge.example.com
CODEBRIDGE_OAUTH_SCOPE=codebridge.read
# Optional comma-separated OAuth subject allowlist. Recommended for personal use.
# Example: auth0|abc123,user-from-another-idp
CODEBRIDGE_OAUTH_ALLOWED_SUBJECTS=
# Unmapped subjects are their own account and can only see devices enrolled with
# their subject as account_id. Example: auth0|abc123=team-a,auth0|def456=team-a
CODEBRIDGE_OAUTH_ACCOUNT_MAP=

# Development fallback only. Ignored when OAuth above is configured.
CODEBRIDGE_MCP_TOKEN=

# Client (agent transport: gRPC host[:port])
CODEBRIDGE_MANAGER_HOST=codebridge.example.com:8081
CODEBRIDGE_DEVICE_ID=my-mac
CODEBRIDGE_DEVICE_NAME=My MacBook Pro
CODEBRIDGE_WORKSPACES=pms=/Users/me/code/pms,portal=/Users/me/code/portal
# Default false. Enabling this permits MCP content tools to access normally
# blocked sensitive files such as .env, private keys, cloud credentials and tfstate.
CODEBRIDGE_ALLOW_SENSITIVE_FILES=false
# Comma-separated workspaces with explicit local write opt-in for
# apply_patch/rollback_patch. Empty (default) keeps the client fully read-only.
# Sensitive paths are never writable even with this enabled.
CODEBRIDGE_WRITABLE_WORKSPACES=
# Default false. When true, symbol tools prefer locally installed language
# servers (gopls, typescript-language-server, jdtls) and fall back to the
# built-in portable parser. Servers run only on this machine.
CODEBRIDGE_ENABLE_LSP=false
# Local caches for the symbol index and write checkpoints (never uploaded).
# CODEBRIDGE_STATE_DIR overrides both defaults; CODEBRIDGE_INDEX_DIR the index only.
CODEBRIDGE_STATE_DIR=
CODEBRIDGE_INDEX_DIR=
# Set this only for first enrollment, then remove it. The client persists the issued
# device credential in CODEBRIDGE_CREDENTIAL_FILE with mode 0600.
CODEBRIDGE_ENROLL_CODE=
CODEBRIDGE_CREDENTIAL_FILE=~/.config/codebridge/credentials.json
# Optional override, useful after an administrator rotates a device credential.
CODEBRIDGE_DEVICE_CREDENTIAL=
